#!/usr/bin/env bash
# Windows-side wrapper (Git Bash): runs gpu-ops inside WSL, in the current directory.
# With this folder on the Windows PATH, agents can just type `gpu-ops …`.
# Inside WSL it calls the real tool by full path, never by bare name: WSL appends the Windows PATH,
# so a bare `gpu-ops` there could resolve back to this wrapper and loop.
# Install the WSL side once:  uv tool install --editable /mnt/c/Users/cuzel/src/gpu-ops
export MSYS_NO_PATHCONV=1
exec wsl.exe -e bash -lc 't="$HOME/.local/bin/gpu-ops"; [ -x "$t" ] || { echo "gpu-ops is not installed inside WSL (expected $t). Run: uv tool install --editable /mnt/c/Users/cuzel/src/gpu-ops" >&2; exit 127; }; exec "$t" "$@"' gpu-ops "$@"
